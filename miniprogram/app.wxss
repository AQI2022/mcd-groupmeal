/* 全局样式：麦当劳红黄主题，竖屏优先，rpx 单位。 */

page {
  background: #FFF8EF;
  color: #2C1810;
  font-size: 30rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
button,
picker {
  box-sizing: border-box;
}

.container {
  padding: 24rpx 24rpx 60rpx;
}

/* ── 卡片 ───────────────────────────────────────── */

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 22rpx rgba(122, 62, 30, 0.08);
}

.card-tight {
  padding: 20rpx 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title .sub {
  font-size: 24rpx;
  font-weight: 400;
  color: #9B7B69;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #6B4A3A;
  margin: 6rpx 0 14rpx;
}

/* ── 行 / 键值 ───────────────────────────────────── */

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.row + .row {
  border-top: 1rpx solid #F6E8DC;
}

.row-label {
  color: #8A6A5B;
  font-size: 28rpx;
  flex-shrink: 0;
}

.row-value {
  font-size: 28rpx;
  text-align: right;
  word-break: break-all;
}

.row-value.strong {
  font-size: 34rpx;
  font-weight: 700;
}

.price-big {
  font-size: 56rpx;
  font-weight: 700;
  color: #DA291C;
  line-height: 1.1;
}

.price-unit {
  font-size: 28rpx;
  font-weight: 600;
  margin-left: 4rpx;
}

.muted {
  color: #9B7B69;
  font-size: 25rpx;
}

.small {
  font-size: 24rpx;
}

.accent {
  color: #DA291C;
}

.good {
  color: #1E8E3E;
}

/* ── 徽标 / 标签 ────────────────────────────────── */

.pill {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.6;
  background: #FFF1D6;
  color: #8A5A00;
}

.pill-red {
  background: #FDE7E5;
  color: #B31C11;
}

.pill-yellow {
  background: #FFC72C;
  color: #4A3200;
  font-weight: 600;
}

.pill-green {
  background: #E6F4EA;
  color: #1E8E3E;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.tag-row .pill {
  margin: 0 12rpx 12rpx 0;
}

/* ── 按钮 ───────────────────────────────────────── */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
  padding: 0 32rpx;
  margin: 0;
  background: #FFFFFF;
  color: #DA291C;
  border: 2rpx solid #F0C9BC;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #DA291C;
  color: #FFFFFF;
  border-color: #DA291C;
  box-shadow: 0 8rpx 20rpx rgba(218, 41, 28, 0.28);
}

.btn-block {
  width: 100%;
  margin-top: 20rpx;
}

.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
  margin: 0;
}

.btn[disabled] {
  opacity: 0.55;
  color: #FFFFFF;
}

.btn-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.btn-bar .btn {
  flex: 1;
  margin-top: 0;
}

/* ── 表单 ───────────────────────────────────────── */

.field {
  margin-bottom: 22rpx;
}

.field-label {
  font-size: 26rpx;
  color: #8A6A5B;
  margin-bottom: 10rpx;
  display: flex;
  justify-content: space-between;
}

.field-label .hint {
  color: #B99C8C;
  font-size: 23rpx;
}

.input,
.picker-box {
  height: 84rpx;
  background: #FFF7F0;
  border: 2rpx solid #F3DFD2;
  border-radius: 16rpx;
  padding: 0 22rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  color: #2C1810;
}

.picker-box {
  justify-content: space-between;
}

.picker-box .placeholder {
  color: #B99C8C;
}

.input-placeholder {
  color: #B99C8C;
}

.stepper {
  display: flex;
  align-items: center;
  background: #FFF7F0;
  border: 2rpx solid #F3DFD2;
  border-radius: 16rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 88rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #DA291C;
  background: #FFF1E8;
}

.stepper-btn.disabled {
  color: #D9C4B8;
}

.stepper-input {
  flex: 1;
  height: 84rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

/* ── 渠道 / 模式切换 ─────────────────────────────── */

.segment {
  display: flex;
  background: #FFF1E8;
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 22rpx;
}

.segment-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8A6A5B;
  border-radius: 14rpx;
}

.segment-item.active {
  background: #FFFFFF;
  color: #DA291C;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(122, 62, 30, 0.12);
}

/* ── 提示块 ─────────────────────────────────────── */

.note {
  background: #FFF7E3;
  border: 2rpx solid #F7E2AE;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 25rpx;
  color: #7A5A18;
  line-height: 1.6;
}

.note-error {
  background: #FDEDEB;
  border-color: #F5C8C2;
  color: #A3221A;
}

.note + .note {
  margin-top: 14rpx;
}

.warn-item {
  font-size: 25rpx;
  color: #8A5A18;
  background: #FFFBF0;
  border-left: 6rpx solid #FFC72C;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
  line-height: 1.55;
}

/* ── 列表 ───────────────────────────────────────── */

.list-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F6E8DC;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item.best {
  background: #FFFBF2;
  border-radius: 14rpx;
  padding: 18rpx 18rpx;
  border-bottom: none;
  margin-bottom: 10rpx;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.item-name {
  font-size: 29rpx;
  font-weight: 600;
}

.item-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #DA291C;
}

.item-price.plain {
  color: #2C1810;
}

/* ── 进度日志 ───────────────────────────────────── */

.logs {
  background: #2B1A12;
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  max-height: 340rpx;
  overflow: hidden;
}

.log-line {
  font-size: 23rpx;
  color: #F6D9C6;
  font-family: Menlo, Consolas, monospace;
  line-height: 1.7;
  word-break: break-all;
}

.log-line.dim {
  color: #A98A78;
}

.loading-bar {
  height: 8rpx;
  border-radius: 999rpx;
  background: #F3DFD2;
  overflow: hidden;
  margin-top: 18rpx;
}

.loading-bar-inner {
  height: 100%;
  width: 40%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FFC72C, #DA291C);
  animation: slide 1.1s ease-in-out infinite;
}

@keyframes slide {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(260%);
  }
}

/* ── 页脚 ───────────────────────────────────────── */

.footer-hint {
  text-align: center;
  font-size: 23rpx;
  color: #B99C8C;
  padding: 10rpx 40rpx 20rpx;
  line-height: 1.7;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
