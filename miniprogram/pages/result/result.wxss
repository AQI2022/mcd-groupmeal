.store-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.store-name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  flex: 1;
  padding-right: 14rpx;
}

.price-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 20rpx 0 8rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #F6E8DC;
  border-bottom: 1rpx solid #F6E8DC;
}

.price-left {
  display: flex;
  align-items: baseline;
}

.price-tag {
  font-size: 24rpx;
  color: #9B7B69;
  margin-left: 10rpx;
}

.perhead {
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.perhead-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C1810;
}

.card .note {
  margin-top: 16rpx;
}

.list-item .item-name {
  line-height: 1.5;
  word-break: break-all;
}

.footer-hint {
  padding-bottom: 24rpx;
}
